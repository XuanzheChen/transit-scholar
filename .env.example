# Copy this file to .env and fill local-only secrets there.
# Do not commit .env.

# --- Active inputs (currently read by the code) ---
# DOI provider credentials. Blank means "not configured": OpenAlex is skipped
# with missing_api_key, Semantic Scholar falls back to public access, and
# Crossref mailto is optional but recommended for the polite pool.
# Never commit real values.
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_MAILTO=

# Active switch: permits the DOI enrichment layer to make real network
# requests. false keeps every provider call offline (pending/network_disabled).
TRANSIT_SCHOLAR_METADATA_ENRICHMENT_ALLOW_NETWORK=false

# --- Layer2 schema extraction real LLM provider (L2S2, task-2026-08-15-001) ---
# Template only: never put a real key in this file. Copy this file to .env and
# fill the real values there (.env is gitignored). Defaults keep everything
# offline/fake: real network requests are only allowed when you explicitly set
# TRANSIT_SCHOLAR_LLM_ALLOW_NETWORK=1 AND fill API_KEY/BASE_URL/MODEL.
TRANSIT_SCHOLAR_LLM_PROVIDER=openai_compatible
TRANSIT_SCHOLAR_LLM_MODEL=
TRANSIT_SCHOLAR_LLM_API_KEY=
TRANSIT_SCHOLAR_LLM_BASE_URL=
TRANSIT_SCHOLAR_LLM_ALLOW_NETWORK=0
TRANSIT_SCHOLAR_LLM_TIMEOUT_SECONDS=60
TRANSIT_SCHOLAR_LLM_MAX_RETRIES=2
TRANSIT_SCHOLAR_LLM_RATE_LIMIT_RPM=20

# Explicit L2S2 schema feature switch (default enabled; 0/false disables the
# documented configuration boundary only — it never turns off persistence).
TRANSIT_SCHOLAR_SCHEMA_ENABLED=1

# --- Layer2 retrieval (active) ---
# Jina grants new API keys a large free token allowance and does not require a
# payment method for the free key. One key is used for both embedding and
# reranking. The generic TRANSIT_SCHOLAR_* variables remain optional overrides.
JINA_API_KEY=
TRANSIT_SCHOLAR_RETRIEVAL_ALLOW_NETWORK=false
TRANSIT_SCHOLAR_BLOCK_NETWORK=true
TRANSIT_SCHOLAR_EMBEDDING_PROVIDER=jina
TRANSIT_SCHOLAR_EMBEDDING_MODEL=jina-embeddings-v3
TRANSIT_SCHOLAR_EMBEDDING_DIMENSION=1024
TRANSIT_SCHOLAR_RERANKER_PROVIDER=jina
TRANSIT_SCHOLAR_RERANKER_MODEL=jina-reranker-v3

# --- Reserved flags (currently non-controlling, demo-stage) ---
# These two switches are reserved for future behavior and are NOT read by any
# code today: toggling them has no effect on the pipeline. The strict-DOI gate
# is currently hard-coded; a later release may wire these flags into behavior.
TRANSIT_SCHOLAR_METADATA_ENRICHMENT_ENABLED=true
TRANSIT_SCHOLAR_METADATA_ENRICHMENT_STRICT_DOI=true
