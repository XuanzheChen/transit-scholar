rd, ExecutionStatus, ResearchSessionRecord\nsrc/transit_scholar/layer3/execution\\__init__.py:11:from .service import AgentRunService, ExecutionService, ResearchSessionService\nsrc/transit_scholar/layer3/execution\\__init__.py:15:    \"ResearchSessionService\",\nsrc/transit_scholar/layer3/execution\\__init__.py:18:    \"ResearchSessionRecord\",\nsrc/transit_scholar/layer3/execution\\__init__.py:23:    \"ResearchSessionNotFoundError\",\nsrc/transit_scholar/layer3/execution\\__init__.py:24:    \"ResearchSessionOwnershipError\",\nsrc/transit_scholar/api/runtime\\manager.py:70:        not submit any work: explicit API resume remains the sole path back to\nsrc/transit_scholar/api/runtime\\manager.py:83:    def submit(self, agent_run_id: str, *, resume: bool = False) -> Future:\nsrc/transit_scholar/api/runtime\\manager.py:86:            return self.submit_reserved(reservation, agent_run_id, resume=resume)\nsrc/transit_scholar/api/runtime\\manager.py:96:        resume: bool = False,\nsrc/transit_scholar/api/runtime\\manager.py:107:            future = self._executor.submit(self._run, agent_run_id, resume)\nsrc/transit_scholar/api/runtime\\manager.py:134:    def _run(self, agent_run_id: str, resume: bool = False):\nsrc/transit_scholar/api/runtime\\manager.py:138:            return product.resume_run(agent_run_id) if resume else product.execute_run(agent_run_id)\nsrc/transit_scholar/layer3/runtime\\run_runtime.py:54:                 is_pause_requested: Callable[[], bool] | None = None,\nsrc/transit_scholar/layer3/runtime\\run_runtime.py:66:        self.is_pause_requested = is_pause_requested or (lambda: False)\nsrc/transit_scholar/layer3/runtime\\run_runtime.py:141:            if self.is_pause_requested():\nsrc/transit_scholar/layer3/runtime\\run_runtime.py:143:                state.termination_reason = \"pause_requested\"\nsrc/transit_scholar/layer3/runtime\\run_runtime.py:146:                    self.execution_service.update_agent_run_status(agent_run_id, \"paused\")\nsrc/