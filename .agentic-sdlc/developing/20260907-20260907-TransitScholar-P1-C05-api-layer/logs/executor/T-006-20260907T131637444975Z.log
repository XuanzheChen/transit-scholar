sts/product\\test_local_product_bootstrap.py:55:        workspace = WorkspaceService(product.session).create(name=\"bootstrap\").workspace\ntests/product\\test_local_product_bootstrap.py:56:        conversation = product.create_conversation(workspace.workspace_id)\ntests/product\\test_local_product_bootstrap.py:67:            workspace_id=workspace.workspace_id, user_goal=\"Compare transit studies\",\ntests/product\\test_research_command_guards.py:10:from transit_scholar.layer3.workspace import WorkspaceService\ntests/product\\test_research_command_guards.py:34:    workspace = WorkspaceService(session).create(name=\"command guard\").workspace\ntests/product\\test_research_command_guards.py:36:        workspace_id=workspace.workspace_id, user_goal=\"Research transit\", status=status,\ntests/product\\test_research_command_guards.py:38:    conversation = service.conversations.create_session(workspace.workspace_id)\ntests/product\\test_paper_library_guard.py:6:from transit_scholar.db.models import Paper, Workspace, WorkspacePaperMembership\ntests/product\\test_paper_library_guard.py:12:def test_library_delete_rejects_active_workspace_membership(session):\ntests/product\\test_paper_library_guard.py:14:    workspace = Workspace(name=\"Active\", status=\"active\", schema_mode=\"none\")\ntests/product\\test_paper_library_guard.py:15:    session.add_all([paper, workspace])\ntests/product\\test_paper_library_guard.py:17:    session.add(WorkspacePaperMembership(workspace_id=workspace.id, paper_id=paper.id))\nsrc/transit_scholar/api\\schemas.py:21:    user_schema_creation: bool\ntests/product\\test_two_turn_integration.py:4:from transit_scholar.db.models import AgentRun, Paper, WorkspacePaperMembership\ntests/product\\test_two_turn_integration.py:15:from transit_scholar.layer3.workspace import WorkspaceService\ntests/product\\test_two_turn_integration.py:22:    def __init__(self, paper_id, workspace_revision):\ntests/product\\test_two_turn_integration.py:24:        self.workspa