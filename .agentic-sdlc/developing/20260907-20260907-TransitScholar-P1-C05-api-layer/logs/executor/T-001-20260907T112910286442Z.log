etrieval_planner.py:        f\"schema_fields={sorted(capabilities.schema_field_ids)!r}; \"\r\nsrc/transit_scholar\\layer3\\prompts\\retrieval_planner.py:        f\"eligible_paper_ids={sorted(capabilities.eligible_paper_ids)!r}; \"\r\nsrc/transit_scholar\\layer3\\prompts\\retrieval_planner.py:        f\"wiki_ready={capabilities.wiki_ready}; \"\r\nsrc/transit_scholar\\layer3\\prompts\\retrieval_planner.py:        f\"max_actions={capabilities.max_actions}; \"\r\nsrc/transit_scholar\\layer3\\prompts\\retrieval_planner.py:        f\"max_action_limit={capabilities.max_action_limit}.\"\r\nsrc/transit_scholar\\web\\static\\index.html:      <span id=\"health-badge\" class=\"badge\">health: &hellip;</span>\r\nsrc/transit_scholar\\web\\static\\index.html:    <span id=\"footer-msg\" class=\"muted\">Loading health&hellip;</span>\r\nsrc/transit_scholar\\web\\static\\app.js:    healthBadge: document.getElementById(\"health-badge\"),\r\nsrc/transit_scholar\\web\\static\\app.js:      const body = await api(\"/api/health\");\r\nsrc/transit_scholar\\web\\static\\app.js:      SEL.healthBadge.textContent = \"health: \" + body.status;\r\nsrc/transit_scholar\\web\\static\\app.js:      SEL.healthBadge.classList.add(\"badge-ok\");\r\nsrc/transit_scholar\\web\\static\\app.js:      SEL.healthBadge.textContent = \"health: error\";\r\nsrc/transit_scholar\\web\\static\\app.js:      SEL.healthBadge.classList.add(\"badge-err\");\r\nsrc/transit_scholar\\layer3\\agentic_wiki\\store.py:        \"\"\"Run a deterministic provenance health pass for one Workspace.\"\"\"\r\nsrc/transit_scholar\\layer3\\agentic_wiki\\store.py:        \"\"\"Read a health flag from an evidence record or nested provenance.\"\"\"\r\nsrc/transit_scholar\\layer3\\agentic_wiki\\maintenance.py:    \"\"\"Runs one lightweight, Workspace-scoped health pass before Session use.\"\"\"\r\nsrc/transit_scholar\\layer3\\planner\\__init__.py:from .capabilities import assemble_retrieval_context\r\nsrc/transit_scholar\\layer3\\planner\\validation.py:    \"\"\"A strategy violates current Workspace capabilities or configured bounds.\"\"\"\r\nsrc/transit_scholar\\layer3\\planner\\validation.py:    capabilities = context.capabilities\r\nsrc/transit_scholar\\layer3\\planner\\validation.py:    if len(strategy.actions) > capabilities.max_actions:\r\nsrc/transit_scholar\\layer3\\planner\\validation.py:        if action.source_kind not in capabilities.available_sources:\r\nsrc/transit_scholar\\layer3\\planner\\validation.py:        if not _tool_is_available(action.source_kind, capabilities.available_tools):\r\nsrc/transit_scholar\\layer3\\planner\\validation.py:        if action.limit > capabilities.max_action_limit:\r\nsrc/transit_scholar\\layer3\\planner\\validation.py:            if not capabilities.wiki_ready:\r\nsrc/transit_scholar\\layer3\\planner\\validation.py:    capabilities = context.capabilities\r\nsrc/transit_scholar\\layer3\\planner\\validation.py:    invalid_fields = set(action.field_ids) - capabilities.schema_field_ids\r\nsrc/transit_scholar\\layer3\\planner\\validation.py:        if not capabilities.schema_ready_paper_ids:\r\nsrc/transit_scholar\\layer3\\planner\\validation.py:    _validate_papers(action.paper_ids, capabilities.eligible_paper_ids)\r\nsrc/transit_scholar\\layer3\\planner\\validation.py:    unavailable = set(action.paper_ids) - capabilities.schema_ready_paper_ids\r\nsrc/transit_scholar\\layer3\\planner\\validation.py:    capabilities = context.capabilities\r\nsrc/transit_scholar\\layer3\\planner\\validation.py:    if not ({required_tool, \"rag\"} & capabilities.available_tools):\r\nsrc/transit_scholar\\layer3\\planner\\validation.py:        if not capabilities.l2s1_ready_paper_ids:\r\nsrc/transit_scholar\\layer3\\planner\\validation.py:    _validate_papers(paper_ids, capabilities.eligible_paper_ids)\r\nsrc/transit_scholar\\layer3\\planner\\validation.py:    unavailable = paper_ids - capabilities.l2s1_ready_paper_ids\r\nsrc/transit_scholar\\layer3\\planner\\validation.py:    \"\"\"A