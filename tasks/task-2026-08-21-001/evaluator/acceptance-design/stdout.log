ttings.semantic_scholar_api_key = old_semantic\ntests\\test_doi_enrichment.py:228:    assert \"S2_SECRET_VALUE\" not in json.dumps(semantic_headers)\ntests\\test_l2s2_public_api.py:596:        issue.type == \"semantic_conflicting\" for issue in result.report.semantic_issues\ntests\\test_l2s2_runtime_wiring.py:14:- the real ``StructuredSemanticVerifier`` sends one structured call carrying\ntests\\test_l2s2_runtime_wiring.py:46:    StructuredSemanticVerifier,\ntests\\test_l2s2_runtime_wiring.py:47:    build_semantic_verifier_messages,\ntests\\test_l2s2_runtime_wiring.py:393:# AC-RW-11/12/13: real StructuredSemanticVerifier\ntests\\test_l2s2_runtime_wiring.py:437:    messages = build_semantic_verifier_messages(field, result)\ntests\\test_l2s2_runtime_wiring.py:455:    verifier = StructuredSemanticVerifier(client)\ntests\\test_l2s2_runtime_wiring.py:471:    verifier = StructuredSemanticVerifier(client)\ntests\\test_l2s2_runtime_wiring.py:482:        (\"partially_supported\", \"semantic_partially_supported\", None),\ntests\\test_l2s2_runtime_wiring.py:483:        (\"unsupported\", \"semantic_unsupported\", \"recheck\"),\ntests\\test_l2s2_runtime_wiring.py:484:        (\"conflicting\", \"semantic_conflicting\", \"recheck\"),\ntests\\test_l2s2_runtime_wiring.py:485:        (\"unclear\", \"semantic_unclear\", None),\ntests\\test_l2s2_runtime_wiring.py:494:    verifier = StructuredSemanticVerifier(client)\ntests\\test_l2s2_runtime_wiring.py:504:def test_verifier_client_failure_becomes_verifier_unavailable():\ntests\\test_l2s2_runtime_wiring.py:506:    verifier = StructuredSemanticVerifier(client)\ntests\\test_l2s2_runtime_wiring.py:508:    assert issues[0].type == \"verifier_unavailable\"\ntests\\test_l2s2_schema_acceptance_evaluate.py:823:                type=\"semantic_unsupported\",\ntests\\test_l2s2_schema_acceptance_evaluate.py:833:    assert merged[0].type == \"semantic_unsupported\"\ntests\\test_l2s2_recheck.py:83:        type=\"semantic_unsupported\",\ntests\\test_l2