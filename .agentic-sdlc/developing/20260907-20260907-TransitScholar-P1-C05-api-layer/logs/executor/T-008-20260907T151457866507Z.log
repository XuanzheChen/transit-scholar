 blob 65008c2decc627d028603e2ae0ecbda7444cdc19\r\nunreachable blob 71004a4df1b9e1b995b82d240c539d16e8b1d110\r\nunreachable blob 77009cf99d780e29810a57bfb6cc0ec3f1e71002\r\nunreachable blob 7b003c91099433ed2fe987375cfd21a10f3a093b\r\nunreachable blob 7f0082b03c623e0805f5666424fc6dd3d96b4eba\r\nunreachable blob 8000aae896dff4c8a71ff5113c9ac26d57a1cf02\r\n\"\"\"Formal API routers.\"\"\"\n\r\nfrom .manager import (\n    AgentRunExecutionManager,\n    LocalAgentRunExecutionManager,\n    LocalExecutionManager,\n    RunnerBusyError,\n)\n\n__all__ = [\"LocalExecutionManager\", \"LocalAgentRunExecutionManager\", \"AgentRunExecutionManager\", \"RunnerBusyError\"]\n\r\nfrom pydantic import BaseModel\n\n\nclass RunStateResponse(BaseModel):\n    agent_run_id: str\n    workspace_id: str\n    status: str\n    phase: str\n    user_goal: str\n    pause_requested: bool = False\n\r\ntests/api\\test_foundation.py:7:    assert \"/api/v1/health\" in paths\ntests/api\\test_foundation.py:8:    assert \"/api/v1/capabilities\" in paths\ntests/api\\test_foundation.py:14:    assert paths[\"/api/v1/health\"][\"get\"][\"responses\"][\"200\"][\"content\"][\"application/json\"][\"schema\"][\"$ref\"].endswith(\"HealthResponse\")\ntests/api\\test_foundation.py:15:    assert paths[\"/api/v1/capabilities\"][\"get\"][\"responses\"][\"200\"][\"content\"][\"application/json\"][\"schema\"][\"$ref\"].endswith(\"CapabilityResponse\")\nsrc/transit_scholar/api\\schemas.py:16:    status: str = \"healthy\"\nsrc/transit_scholar/api\\schemas.py:22:    base_wiki: bool\nsrc/transit_scholar/api\\schemas.py:23:    agentic_wiki: bool\nsrc/transit_scholar/api\\schemas.py:24:    semantic_wiki_search: bool\nsrc/transit_scholar/api\\schemas\\__init__.py:16:    status: str = \"healthy\"\nsrc/transit_scholar/api\\schemas\\__init__.py:22:    base_wiki: bool\nsrc/transit_scholar/api\\schemas\\__init__.py:23:    agentic_wiki: bool\nsrc/transit_scholar/api\\schemas\\__init__.py:24:    semantic_wiki_search: bool\n","exit_code":0