sts\\integration\\test_l3s6_role_context_integration.py:13:from transit_scholar.layer3.execution import AgentRunService\r\ntests\\integration\\test_l3s6_role_context_integration.py:16:from transit_scholar.layer3.workspace import WorkspaceService\r\ntests\\integration\\test_l3s6_role_context_integration.py:74:    workspace = WorkspaceService(session).create(name=\"L3S6 real RoleContext path\").workspace\r\ntests\\integration\\test_l3s6_role_context_integration.py:75:    execution = AgentRunService(session)\r\ntests\\test_l2s3_package_a_store.py:15:    WorkspaceContext,\r\ntests\\test_l2s3_package_a_store.py:24:    return WorkspaceContext(workspace_id=workspace, schema_id=\"schema\", schema_version=\"1\", paper_ids=[\"p1\", \"p2\"])\r\ntests\\test_l3s1_gateway_schema_isolation.py:1:\"\"\"Layer3 Stage1 gateway Workspace-Schema isolation tests (T-005 / AC-020).\r\ntests\\test_l3s1_gateway_schema_isolation.py:3:Proves through the bound gateway that Workspace Schema reads resolve the\r\ntests\\test_l3s1_gateway_schema_isolation.py:4:Workspace-specific Schema storage root only:\r\ntests\\test_l3s1_gateway_schema_isolation.py:6:- AC-020: a bound-schema Workspace read returns only that Workspace's\r\ntests\\test_l3s1_gateway_schema_isolation.py:8:  Workspace's instance (AC-006/AC-007 semantics at the gateway boundary);\r\ntests\\test_l3s1_gateway_schema_isolation.py:9:- deleting one Workspace's Schema storage leaves the other's content intact\r\ntests\\test_l3s1_gateway_schema_isolation.py:12:  path): content stranded in a Workspace's root never re-authorizes a\r\ntests\\test_l3s1_gateway_schema_isolation.py:14:- no-schema Workspaces report ``schema_disabled`` through the gateway with no\r\ntests\\test_l3s1_gateway_schema_isolation.py:17:  with the Workspace binding is rejected through the gateway with the stable\r\ntests\\test_l3s1_gateway_schema_isolation.py:35:from transit_scholar.layer3.knowledge import WorkspaceKnowledgeGateway\r\ntests\\test_l3s1_gateway_schema_isolation.py:41:from transit_scholar.layer3.schema.service import WorkspaceSchemaService\r\ntests\\test_l3s1_gateway_schema_isolation.py:45:    WorkspaceService,\r\ntests\\test_l3s1_gateway_schema_isolation.py:86:    return WorkspaceService(session).create(\r\ntests\\test_l3s1_gateway_schema_isolation.py:92:    return WorkspaceService(session).create(name=name, workspace_id=workspace_id).workspace\r\ntests\\test_l3s1_gateway_schema_isolation.py:96:    return WorkspaceSchemaService(session, data_root=project_tmp_path)\r\ntests\\test_l3s1_gateway_schema_isolation.py:100:    return WorkspaceKnowledgeGateway(\r\ntests\\test_l3s1_gateway_schema_isolation.py:106:# AC-020: schema reads resolve the bound Workspace storage root only\r\ntests\\test_l3s1_gateway_schema_isolation.py:116:    service = WorkspaceService(session)\r\n","exit_code":1,"status":"failed"}}
