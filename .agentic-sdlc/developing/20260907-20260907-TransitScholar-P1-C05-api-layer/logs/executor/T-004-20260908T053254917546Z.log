ld(default=0, ge=0)\r\n  34:     tool_calls: int = Field(default=0, ge=0)\r\n  35:     failures: int = Field(default=0, ge=0)\r\n  36: \r\n  37: \r\n  38: class MainRuntimeResult(BaseModel):\r\n  39:     model_config = ConfigDict(extra=\"forbid\")\r\n  40: \r\n  41:     agent_run_id: str\r\n  42:     research_session_id: str\r\n  43:     status: str\r\n  44:     termination_reason: str\r\n  45:     usage: MainRuntimeUsage\r\n  46:     role_results: list[RoleResult] = Field(default_factory=list)\r\n  47:     final_response: FinalResponseArtifact | None = None\r\n  48:     failure_message: str | None = None\r\n  49: \r\n  50: \r\n  51: class MainRuntimeState(BaseModel):\r\n  52:     model_config = ConfigDict(extra=\"forbid\")\r\n  53: \r\n  54:     agent_run_id: str\r\n  55:     research_session_id: str\r\n  56:     status: str = \"running\"\r\n  57:     next_role_id: RoleId = RoleId.RESEARCH_COORDINATOR\r\n  58:     current_role_execution_id: str | None = None\r\n  59:     usage: MainRuntimeUsage = Field(default_factory=MainRuntimeUsage)\r\n  60:     role_results: list[RoleResult] = Field(default_factory=list)\r\n  61:     latest_retrieval_observation: list[dict[str, Any]] = Field(default_factory=list)\r\n  62:     final_response: FinalResponseArtifact | None = None\r\n  63:     termination_reason: str | None = None\r\n  64:     failure_message: str | None = None\r\n  65:     session_handoff: Any | None = None\r\n  66: \r\n  67: \r\n  68: class ContextBuilder(Protocol):\r\n  69:     def build(self, *, agent_run_id: str, research_session_id: str, **kwargs: Any) -> object: ...\r\n  70: \r\n  71: \r\n  72: class ExecutionService(Protocol):\r\n  73:     def get_agent_run(self, agent_run_id: str) -> object: ...\r\n  74:     def get_research_session(self, agent_run_id: str, research_session_id: str) -> object: ...\r\n  75:     def update_research_session_status(\r\n  76:         self, agent_run_id: str, research_session_id: str, status: str\r\n  77:     ) -> object: ...\r\n  78: \r\n  79: \r\n  80: class TraceSink(Protocol):\r\n  81:     def append_event(self, **event: Any) -> object: ...\r\n  82: \r\n  83: \r\n  84: class MainRuntimeStateStore(Protocol):\r\n  85:     def save_research_state(self, **kwargs: Any) -> object: ...\r\n  86:     def load_research_state(self, **kwargs: Any) -> object: ...\r\n  87: \r\n  88: \r\n  89: RoleInputFactory = Callable[[RoleId, object], BaseModel | dict[str, object]]\r\n  90: ActionPlanner = Callable[\r\n  91:     [RoleDefinition, BaseModel | dict[str, object], object],\r\n  92:     list[AgentAction] | tuple[AgentAction, ...],\r\n  93: ]\r\n  94: \r\n  95: \r\n  96: class MainResearchRuntime:\r\n  97:     \"\"\"Execute predefined Roles until completion or a deterministic limit.\"\"\"\r\n  98: \r\n  99:     requires_authoritative_session = True\r\n 100:     requires_execution_service = True\r\n 101: \r\n 102:     def __init__(\r\n 103:         self,\r\n 104:         *,\r\n 105:         registry: RoleRegistry,\r\n 106:         role_runtime: RoleRuntime,\r\n 107:         execution_service: ExecutionService,\r\n 108:         context_builder: ContextBuilder,\r\n 109:         policies: Mapping[RoleId | str, RolePolicy],\r\n 110:         config: MainRuntimeConfig | None = None,\r\n 111:         projector: RoleContextProjector | None = None,\r\n 112:         trace: TraceSink | None = None,\r\n 113:         role_input_factory: RoleInputFactory | None = None,\r\n 114:         action_planner: ActionPlanner | None = None,\r\n 115:         action_executor: object | None = None,\r\n 116:         is_cancelled: Callable[[], bool] | None = None,\r\n 117:         state_store: MainRuntimeStateStore | None = None,\r\n 118:         agentic_wiki_maintenance: Callable[[str], object] | None = None,\r\n 119:         agentic_wiki_base_dir: str | None = None,\r\n 120:         workspace_service: object | None = None,\r\n 121:         ledger_service: object | None = None,\r\n 122:         episodic_memory_retriever: EpisodicMemoryRetriever | None = None,\r\n 123:         episodic_memory_top_k: int = 5,\r\n 124:     ) -> None:\r\n 125:         self.registry = registry\r\n 126:         self.role_runtime = role_runtime\r\n 127:         self.execution_service = execution_service\r\n 128:         self.context_builder = context_builder\r\n 129:         self.policies = {RoleId(key): value for key, value in policies.items()}\r\n 130:         self.config = config or MainRuntimeConfig()\r\n 131:         self.projector = projector or RoleContextProjector()\r\n 132:         self.trace = trace\r\n 133:         self.role_input_factory = role_input_factory or self._default_role_input\r\n 134:         self.action_planner = action_planner\r\n 135:         self.action_executor = action_executor\r\n 136:         if (\r\n 137:             action_executor is not None\r\n 138:             and getattr(self.role_runtime, \"action_executor\", None) is None\r\n 139:         ):\r\n 140:             self.role_runtime.action_executor = action_executor\r\n 141:         self.is_cancelled = is_cancelled or (lambda: False)\r\n 142:         self.state_store = state_store\r\n 143:         self._agentic_wiki_maintenance_explicit = agentic_wiki_maintenance is not None\r\n 144:         self.agentic_wiki_maintenance = agentic_wiki_maintenance\r\n 145:         if self.agentic_wiki_maintenance is None:\r\n 146:             self.agentic_wiki_maintenance = self._default_agentic_wiki_maintenance(\r\n 147:                 base_dir=agentic_wiki_base_dir,\r\n 148:                 workspace_service=workspace_service,\r\n 149:                 ledger_service=ledger_service,\r\n 150:             )\r\n 151:         if episodic_memory_top_k < 0:\r\n 152:             raise ValueError(\"episodic_memory_top_k must not be negative\")\r\n 153:         self.episodic_memory_retriever = episodic_memory_retriever\r\n 154:         self.episodic_memory_top_k = episodic_memory_top_k\r\n 155: \r\n 156:     def _default_agentic_wiki_maintenance(\r\n 157:         self,\r\n 158:         *,\r\n 159:         base_dir: str | None,\r\n 160:         workspace_service: object | None,\r\n 161:         ledger_service: object | None,\r\n 162:     ) -> Callable[[str], object] | None:\r\n 163:         \"\"\"Compose the production Session-start provenance boundary lazily.\r\n 164: \r\n 165:         Existing callers that provide an explicit hook keep that hook.  The\r\n 166:         normal authoritative ``AgentRunService`` path supplies a SQLAlchemy\r\n 167:         session, from which Workspace and L3S4 readers can be composed without\r\n 168:         caller-managed resolver collections.\r\n 169:         \"\"\"\r\n 170:         execution = self.execution_service\r\n 171:         db_session = getattr(execution, \"session\", None)\r\n 172:         if workspace_service is None:\r\n 173:             workspace_service = getattr(execution, \"workspaces\", None)\r\n 174:         if db_session is None and workspace_service is not None:\r\n 175:             db_session = getattr(workspace_service, \"session\", None)\r\n 176:         if ledger_service is None and db_session is not None:\r\n 177:             try:\r\n 178:                 from transit_scholar.layer3.ledger import ResearchReasoningLedgerService\r\n 179: \r\n 180:                 ledger_service = ResearchReasoningLedgerService(db_session)\r\n 181:             except (ImportError, TypeError):\r\n 182:                 ledger_service = None\r\n 183:         if workspace_service is None and db_session is not None:\r\n 184:             try:\r\n 185:                 from transit_scholar.layer3.workspace import WorkspaceService\r\n 186: \r\n 187:                 workspace_service = WorkspaceService(db_session)\r\n 188:             except (ImportError, TypeError):\r\n 189:                 workspace_service = None\r\n 190:         if workspace_service is None and ledger_service is None:\r\n 191:             return None\r\n 192: \r\n 193:         def maintain(workspace_id: str) -> object:\r\n 194:             from transit_scholar.layer3.agentic_wiki import AgenticWikiMaintenance\r\n 195: \r\n 196:             return AgenticWikiMaintenance.for_workspace(\r\n 197:                 workspace_id,\r\n 198:                 base_dir=base_dir,\r\n 199:                 workspace_service=workspace_service,\r\n 200:                 ledger_service=ledger_service,\r\n 201:                 execution_service=execution,\r\n 202:             )(workspace_id)\r\n 203: \r\n 204:         return maintain\r\n 205: \r\n 206:     def execute(self, *, agent_run_id: str, research_session_id: str, session_handoff: object | None = None) -> MainRuntimeResult:\r\n 207:         state = MainRuntimeState(\r\n 208:             agent_run_id=agent_run_id, research_session_id=research_session_id,\r\n 209:             session_handoff=session_handoff,\r\n 210:         )\r\n 211:         return self._execute_state(state, resumed=False, session_handoff=session_handoff)\r\n 212: \r\n 213:     def resume_session(\r\n 214:         self, *, agent_run_id: str, research_session_id: str,\r\n 215:         session_handoff: object | None = None,\r\n 216:     ) -> MainRuntimeResult:\r\n 217:         if self.state_store is None:\r\n 218:             raise RuntimeError(\"resume_session requires a durable Main Runtime state store\")\r\n 219:         record = self.state_store.load_research_state(\r\n 220:             agent_run_id=agent_run_id, research_session_id=research_session_id\r\n 221:         )\r\n 222:         payload = getattr(record, \"payload\", None) if record is not None else None\r\n 223:         if not isinstance(payload, dict) or \"l3s5\" not in payload:\r\n 224:             raise LookupError(\"No durable L3S5 continuation state exists for this session\")\r\n 225:         state = MainRuntimeState.model_validate(payload[\"l3s5\"])\r\n 226:         if (\r\n 227:             state.agent_run_id != agent_run_id\r\n 228:             or state.research_session_id != research_session_id\r\n 229:         ):\r\n 230:             raise ValueError(\"Persisted Main Runtime state belongs to another session\")\r\n 231:         handoff = state.session_handoff if state.session_handoff is not None else session_handoff\r\n 232:         return self._execute_state(state, resumed=True, session_handoff=handoff)\r\n 233: \r\n 234:     def _execute_state(self, state: MainRuntimeState, *, resumed: bool, session_handoff: object | None = None) -> MainRuntimeResult:\r\n 235:         agent_run_id = state.agent_run_id\r\n 236:         research_session_id = state.research_session_id\r\n 237:         run = self.execution_service.get_agent_run(agent_run_id)\r\n 238:         if self.agentic_wiki_maintenance is not None:\r\n 239:             workspace_id = getattr(run, \"workspace_id\", None)\r\n 240:             if workspace_id is None and isinstance(run, Mapping):\r\n 241:                 workspace_id = run.get(\"workspace_id\")\r\n 242:             if workspace_id:\r\n 243:                 self.agentic_wiki_maintenance(str(workspace_id))\r\n 244:         session = self.execution_service.get_research_session(agent_run_id, research_session_id)\r\n 245:         usage = state.usage\r\n 246:         results = state.role_results\r\n 247:         final_response = state.final_response\r\n 248:         status = state.status\r\n 249:         reason = state.termination_reason or \"unknown\"\r\n 250:         failure_message = state.failure_message\r\n 251:         if state.session_handoff is not None:\r\n 252:             session_handoff = state.session_handoff\r\n 253:         elif session_handoff is not None:\r\n 254:             state.session_handoff = session_handoff\r\n 255:         next_role = state.next_role_id\r\n 256:         retrieved_evidence: list[object] = list(state.latest_retrieval_observation)\r\n 257:         if status != \"running\":\r\n 258:             return self._state_result(state)\r\n 259:         self.execution_service.update_research_session_status(\r\n 260:             agent_run_id, research_session_id, \"running\"\r\n 261:         )\r\n 262:         self._trace(\r\n 263:             agent_run_id, research_session_id,\r\n 264:             \"runtime.resume\" if resumed else \"runtime.start\", usage,\r\n 265:         )\r\n 266:         self._save_state(state)\r\n 267: \r\n 268:         while status == \"running\":\r\n 269:             reason = self._limit_reason(usage)\r\n 270:             if reason:\r\n 271:                 status = \"terminated\"\r\n 272:                 break\r\n 273:             role = self.registry.get(next_role)\r\n 274:             policy = self.policies.get(next_role)\r\n 275:             if policy is None:\r\n 276:                 usage.failures += 1\r\n 277:                 failure_message = f\"No policy configured for Role {next_role.value}\"\r\n 278:                 status, reason = self._failure_outcome(usage)\r\n 279:                 break\r\n 280:             try:\r\n 281:                 build_kwargs = {\r\n 282:                     \"agent_run_id\": agent_run_id,\r\n 283:                     \"research_session_id\": research_session_id,\r\n 284:                     \"retrieved_evidence\": retrieved_evidence,\r\n 285:                 }\r\n 286:                 if session_handoff is not None:\r\n 287:                     build_kwargs[\"session_handoff\"] = session_handoff\r\n 288:                 if (\r\n 289:                     next_role == RoleId.QUERY_PLANNING\r\n 290:                     and self.episodic_memory_retriever is not None\r\n 291:                 ):\r\n 292:                     build_kwargs[\"episodic_memory\"] = self._retrieve_episodic_memory(\r\n 293:                         run, session\r\n 294:                     )\r\n 295:                 snapshot = self.context_builder.build(**build_kwargs)\r\n 296:                 projected = self.projector.project(snapshot, role)\r\n 297:                 role_input = self.role_input_factory(next_role, projected)\r\n 298:                 role_execution_id = state.current_role_execution_id or uuid4().hex\r\n 299:                 state.current_role_execution_id = role_execution_id\r\n 300:                 state.next_role_id = next_role\r\n 301:                 self._save_state(state)\r\n 302:                 role_result = self.role_runtime.execute(\r\n 303:                     role,\r\n 304:                     role_input,\r\n 305:                     policy,\r\n 306:                     agent_run_id=agent_run_id,\r\n 307:                     research_session_id=research_session_id,\r\n 308:                     role_context=projected,\r\n 309:                     action_planner=(\r\n 310:                         (\r\n 311:                             lambda definition, output, context: self.action_planner(\r\n 312:                                 definition,\r\n 313:                                 output.model_dump(mode=\"json\")\r\n 314:                                 if isinstance(output, BaseModel)\r\n 315:                                 else output,\r\n 316:                                 context,\r\n 317:                             )\r\n 318:                         )\r\n 319:                         if self.action_planner is not None\r\n 320:                         else None\r\n 321:                     ),\r\n 322:                     role_execution_id=role_execution_id,\r\n 323:                 )\r\n 324:             except Exception as exc:\r\n 325:                 usage.failures += 1\r\n 326:                 failure_message = str(exc)\r\n 327:                 status, reason = self._failure_outcome(usage)\r\n 328:                 self._trace(\r\n 329:                     agent_run_id, research_session_id, \"runtime.failure\", usage,\r\n 330:                     role_id=next_role.value, failure_message=failure_message,\r\n 331:                 )\r\n 332:                 if status == \"running\":\r\n 333:                     next_role = RoleId.RESEARCH_COORDINATOR\r\n 334:                     continue\r\n 335:                 break\r\n 336: \r\n 337:             results.append(role_result)\r\n 338:             state.current_role_execution_id = None\r\n 339:             usage.steps += 1\r\n 340:             usage.llm_calls += role_result.working_state.usage.llm_calls\r\n 341:             usage.tool_calls += role_result.working_state.usage.tool_calls\r\n 342:             self._trace(\r\n 343:                 agent_run_id, research_session_id, \"runtime.step\", usage,\r\n 344:                 role_id=next_role.value, role_execution_id=role_result.role_execution_id,\r\n 345:                 role_status=role_result.status,\r\n 346:             )\r\n 347:             if role_result.status != \"completed\":\r\n 348:                 usage.failures += 1\r\n 349:                 failure_message = role_result.failure_message\r\n 350:                 status, reason = self._failure_outcome(usage)\r\n 351:                 self._trace(\r\n 352:                     agent_run_id, research_session_id, \"runtime.failure\", usage,\r\n 353:                     role_id=next_role.value,\r\n 354:                     role_execution_id=role_result.role_execution_id,\r\n 355:                     role_status=role_result.status,\r\n 356:                     failure_message=failure_message,\r\n 357:                 )\r\n 358:                 next_role = RoleId.RESEARCH_COORDINATOR\r\n 359:                 continue\r\n 360: \r\n 361:             output = role_result.output or {}\r\n 362:             # Specialist actions are executed inside RoleRuntime. Retrieval\r\n 363:             # observations are recovered from the committed action boundary.\r\n 364:             if role_result.working_state.intermediate_artifacts:\r\n 365:                 for artifact in role_result.working_state.intermediate_artifacts:\r\n 366:                     action = artifact.get(\"action\", {})\r\n 367:                     self._trace(\r\n 368:                         agent_run_id,\r\n 369:                         research_session_id,\r\n 370:                         \"runtime.action\",\r\n 371:                         usage,\r\n 372:                         role_id=next_role.value,\r\n 373:                         role_execution_id=role_result.role_execution_id,\r\n 374:                         action_type=action.get(\"action_type\"),\r\n 375:                         action_result=artifact.get(\"result\"),\r\n 376:                     )\r\n 377:                     if action.get(\"action_type\") == \"RETRIEVE_QUERY\":\r\n 378:                         value = artifact.get(\"result\")\r\n 379:                         if isinstance(value, dict) and \"value\" in value:\r\n 380:                             value = value[\"value\"]\r\n 381:                         if isinstance(value, RetrievalResultEnvelope):\r\n 382:                             value = value.evidence_results\r\n 383:                         if isinstance(value, dict) and \"evidence_results\" in value:\r\n 384:                             value = value[\"evidence_results\"]\r\n 385:                         retrieved_evidence = [\r\n 386:                             item\r\n 387:                             if isinstance(item, dict)\r\n 388:                             else RetrievedEvidenceContext(\r\n 389:                                 evidence_id=item.evidence_id,\r\n 390:                                 payload=item.model_dump(mode=\"json\"),\r\n 391:                             ).model_dump(mode=\"json\")\r\n 392:                             for item in (value or [])\r\n 393:                         ]\r\n 394:                         state.latest_retrieval_observation = list(retrieved_evidence)\r\n 395:             if next_role == RoleId.FINAL_SYNTHESIS and output.get(\"completed\"):\r\n 396:                 final_response = FinalSynthesisRole.finalize(role_input, output)\r\n 397:                 status, reason = \"completed\", \"semantic_completion\"\r\n 398:             elif next_role == RoleId.RESEARCH_COORDINATOR:\r\n 399:                 selected = output.get(\"next_role_id\")\r\n 400:                 if output.get(\"completed\") and selected is None:\r\n 401:                     status, reason = \"completed\", \"semantic_completion\"\r\n 402:                 elif selected is None:\r\n 403:                     usage.failures += 1\r\n 404:                     failure_message = \"Coordinator did not select a predefined Role\"\r\n 405:                     status, reason = self._failure_outcome(usage)\r\n 406:                 else:\r\n 407:                     next_role = RoleId(selected)\r\n 408:             else:\r\n 409:                 next_role = RoleId.RESEARCH_COORDINATOR\r\n 410:             state.next_role_id = next_role\r\n 411:             state.usage = usage\r\n 412:             state.role_results = results\r\n 413:             state.status = status\r\n 414:             state.termination_reason = reason\r\n 415:             state.failure_message = failure_message\r\n 416:             state.final_response = final_response\r\n 417:             self._save_state(state)\r\n 418: \r\n 419:         session_status = \"completed\" if status == \"completed\" else (\r\n 420:             \"cancelled\" if reason == \"cancelled\" else \"failed\"\r\n 421:         )\r\n 422:         self.execution_service.update_research_session_status(\r\n 423:             agent_run_id, research_session_id, session_status\r\n 424:         )\r\n 425:         self._trace(\r\n 426:             agent_run_id, research_session_id, \"runtime.completion\", usage,\r\n 427:             status=status, termination_reason=reason,\r\n 428:         )\r\n 429:         state.status = status\r\n 430:         state.termination_reason = reason\r\n 431:         state.failure_message = failure_message\r\n 432:         state.final_response = final_response\r\n 433:         state.usage = usage\r\n 434:         state.role_results = results\r\n 435:         self._save_state(state)\r\n 436:         return self._state_result(state)\r\n 437: \r\n 438:     @staticmethod\r\n 439:     def _state_result(state: MainRuntimeState) -> MainRuntimeResult:\r\n 440:         return MainRuntimeResult(\r\n 441:             agent_run_id=state.agent_run_id,\r\n 442:             research_session_id=state.research_session_id,\r\n 443:             status=state.status,\r\n 444:             termination_reason=state.termination_reason,\r\n 445:             usage=state.usage,\r\n 446:             role_results=state.role_results,\r\n 447:             final_response=state.final_response,\r\n 448:             failure_message=state.failure_message,\r\n 449:         )\r\n 450: \r\n 451:     def _save_state(self, state: MainRuntimeState) -> None:\r\n 452:         if self.state_store is None:\r\n 453:             return\r\n 454:         existing = self.state_store.load_research_state(\r\n 455:             agent_run_id=state.agent_run_id,\r\n 456:             research_session_id=state.research_session_id,\r\n 457:         )\r\n 458:         payload = dict(getattr(existing, \"payload\", {}) or {})\r\n 459:         payload[\"l3s5\"] = state.model_dump(mode=\"json\")\r\n 460:         self.state_store.save_research_state(\r\n 461:             agent_run_id=state.agent_run_id,\r\n 462:             research_session_id=state.research_session_id,\r\n 463:             payload=payload,\r\n 464:         )\r\n 465: \r\n 466:     def _limit_reason(self, usage: MainRuntimeUsage) -> str | None:\r\n 467:         if self.is_cancelled():\r\n 468:             return \"cancelled\"\r\n 469:         if usage.steps >= self.config.max_steps:\r\n 470:             return \"max_steps\"\r\n 471:         if usage.llm_calls >= self.config.max_llm_calls:\r\n 472:             return \"max_llm_calls\"\r\n 473:         if usage.tool_calls >= self.config.max_tool_calls:\r\n 474:             return \"max_tool_calls\"\r\n 475:         if usage.failures >= self.config.max_failures:\r\n 476:             return \"max_failures\"\r\n 477:         return None\r\n 478: \r\n 479:     def _failure_outcome(self, usage: MainRuntimeUsage) -> tuple[str, str]:\r\n 480:         if usage.failures >= self.config.max_failures:\r\n 481:             return \"failed\", \"max_failures\"\r\n 482:         return \"running\", \"role_failure_recovered\"\r\n 483: \r\n 484:     def _retrieve_episodic_memory(self, run: object, session: object) -> tuple[object, ...]:\r\n 485:         \"\"\"Select bounded Workspace experience for QueryPlanningRole only.\"\"\"\r\n 486:         if self.episodic_memory_retriever is None or self.episodic_memory_top_k == 0:\r\n 487:             return ()\r\n 488:         workspace_id = self._field(run, \"workspace_id\")\r\n 489:         if not workspace_id:\r\n 490:             return ()\r\n 491:         query = self._field(session, \"research_question\") or self._field(\r\n 492:             run, \"user_goal\"\r\n 493:         )\r\n 494:         if not query:\r\n 495:             return ()\r\n 496:         return self.episodic_memory_retriever.retrieve(\r\n 497:             workspace_id=str(workspace_id),\r\n 498:             query=str(query),\r\n 499:             top_k=self.episodic_memory_top_k,\r\n 500:         )\r\n 501: \r\n 502:     @staticmethod\r\n 503:     def _field(value: object, name: str) -> object | None:\r\n 504:         if isinstance(value, Mapping):\r\n 505:             return value.get(name)\r\n 506:         return getattr(value, name, None)\r\n 507: \r\n 508:     @staticmethod\r\n 509:     def _default_role_input(role_id: RoleId, context: object) -> dict[str, object]:\r\n 510:         sections = getattr(context, \"sections\")\r\n 511:         session = sections.get(\"session\", {})\r\n 512:         research_session = session.get(\"research_session\", {})\r\n 513:         session_id = research_session.get(\"research_session_id\", \"\")\r\n 514:         question = research_session.get(\"research_question\", \"\")\r\n 515:         if role_id == RoleId.RESEARCH_COORDINATOR:\r\n 516:             return {\"research_session_id\": session_id, \"research_goal\": question}\r\n 517:         if role_id == RoleId.QUERY_PLANNING:\r\n 518:             return {\"research_session_id\": session_id, \"research_question\": question}\r\n 519:         if role_id == RoleId.EVIDENCE_REASONING:\r\n 520:             return {\r\n 521:                 \"research_session_id\": session_id,\r\n 522:                 \"evidence_ids\": [item[\"evidence_id\"] for item in sections.get(\"retrieved_evidence\", [])],\r\n 523:             }\r\n 524:         if role_id == RoleId.CLAIM_REASONING:\r\n 525:             return {\r\n 526:                 \"research_session_id\": session_id,\r\n 527:                 \"accepted_evidence_ids\": [item[\"evidence_id\"] for item in sections.get(\"accepted_evidence\", [])],\r\n 528:             }\r\n 529:         return {\r\n 530:             \"research_session_id\": session_id,\r\n 531:             \"claims\": sections.get(\"claims\", ()),\r\n 532:             \"accepted_evidence\": sections.get(\"accepted_evidence\", ()),\r\n 533:             \"claim_evidence_links\": sections.get(\"claim_evidence_links\", ()),\r\n 534:         }\r\n 535: \r\n 536:     def _trace(\r\n 537:         self, agent_run_id: str, research_session_id: str, event_type: str,\r\n 538:         usage: MainRuntimeUsage, **payload: Any,\r\n 539:     ) -> None:\r\n 540:         if self.trace is not None:\r\n 541:             self.trace.append_event(\r\n 542:                 agent_run_id=agent_run_id,\r\n 543:                 research_session_id=research_session_id,\r\n 544:                 event_type=event_type,\r\n 545:                 payload={\"usage\": usage.model_dump(), **payload},\r\n 546:             )\r\n 547: \r\n 548:     @staticmethod\r\n 549:     def _json_value(value: object) -> Any:\r\n 550:         if isinstance(value, BaseModel):\r\n 551:             return value.model_dump(mode=\"json\")\r\n 552:         if isinstance(value, (str, int, float, bool, list, dict)) or value is None:\r\n 553:             return value\r\n 554:         return repr(value)\r\n 555: \r\n 556: \r\n 557: AgentRuntime = MainResearchRuntime\r\n 558: \r\n 559: __all__ = [\r\n 560:     \"AgentRuntime\", \"FinalResponseArtifact\", \"MainResearchRuntime\",\r\n 561:     \"MainRuntimeResult\", \"MainRuntimeState\", \"MainRuntimeStateStore\", \"MainRuntimeUsage\",\r\n 562: ]\r\n\nsrc/transit_scholar/layer3/runtime/role_runtime.py\r\n   1: \"\"\"Plain-Python Role execution loop.\"\"\"\r\n   2: \r\n   3: from __future__ import annotations\r\n   4: \r\n   5: import os\r\n   6: from collections.abc import Callable, Iterable\r\n   7: from pathlib import Path\r\n   8: from typing import Any, Protocol\r\n   9: from uuid import uuid4\r\n  10: \r\n  11: from pydantic import BaseModel, ValidationError\r\n  12: \r\n  13: from transit_scholar.layer3.agent.models import (\r\n  14:     RoleDefinition,\r\n  15:     RoleExecution,\r\n  16:     RolePolicy,\r\n  17:     RoleResult,\r\n  18:     StructuredOutputRepairContext,\r\n  19: )\r\n  20: from transit_scholar.layer3.agent.registry import RoleRegistry\r\n  21: from transit_scholar.layer3.context import RoleContext\r\n  22: \r\n  23: \r\n  24: class RoleExecutionStore(Protocol):\r\n  25:     def save(self, execution: RoleExecution) -> None: ...\r\n  26:     def load(self, role_execution_id: str) -> RoleExecution: ...\r\n  27: \r\n  28: \r\n  29: class ProviderRetryableError(Exception):\r\n  30:     \"\"\"A transient provider failure eligible for same-step retry.\"\"\"\r\n  31: \r\n  32: \r\n  33: class RoleTrace(Protocol):\r\n  34:     def append_event(\r\n  35:         self,\r\n  36:         *,\r\n  37:         agent_run_id: str,\r\n  38:         event_type: str,\r\n  39:         payload: dict[str, Any],\r\n  40:         research_session_id: str | None = None,\r\n  41:     ) -> object: ...\r\n  42: \r\n  43: \r\n  44: class RoleActionExecutor(Protocol):\r\n  45:     def execute(self, action: object, role: RoleDefinition) -> object: ...\r\n  46: \r\n  47: \r\n  48: class InMemoryRoleExecutionStore:\r\n  49:     def __init__(self) -> None:\r\n  50:         self._records: dict[str, str] = {}\r\n  51: \r\n  52:     def save(self, execution: RoleExecution) -> None:\r\n  53:         self._records[execution.role_execution_id] = execution.model_dump_json()\r\n  54: \r\n  55:     def load(self, role_execution_id: str) -> RoleExecution:\r\n  56:         return RoleExecution.model_validate_json(self._records[role_execution_id])\r\n  57: \r\n  58: \r\n  59: class FileRoleExecutionStore:\r\n  60:     \"\"\"Durable, atomic JSON snapshots for recoverable Role executions.\"\"\"\r\n  61: \r\n  62:     def __init__(self, root: str | Path) -> None:\r\n  63:         self.root = Path(root)\r\n  64: \r\n  65:     def save(self, execution: RoleExecution) -> None:\r\n  66:         target = self._path(execution.role_execution_id)\r\n  67:         self.root.mkdir(parents=True, exist_ok=True)\r\n  68:         temporary = target.with_name(f\".{target.name}.{uuid4().hex}.tmp\")\r\n  69:         try:\r\n  70:             temporary.write_text(execution.model_dump_json(indent=2) + \"\\n\", encoding=\"utf-8\")\r\n  71:             os.replace(temporary, target)\r\n  72:         finally:\r\n  73:             temporary.unlink(missing_ok=True)\r\n  74: \r\n  75:     def load(self, role_execution_id: str) -> RoleExecution:\r\n  76:         return RoleExecution.model_validate_json(self._path(role_execution_id).read_text(\"utf-8\"))\r\n  77: \r\n  78:     def _path(self, role_execution_id: str) -> Path:\r\n  79:         if not role_execution_id or Path(role_execution_id).name != role_execution_id:\r\n  80:             raise ValueError(\"role_execution_id must be a non-empty file-safe identifier\")\r\n  81:         return self.root / f\"{role_execution_id}.json\"\r\n  82: \r\n  83: \r\n  84: class RoleRuntime:\r\n  85:     \"\"\"Executes registered one-step and multi-step Roles through one interface.\"\"\"\r\n  86: \r\n  87:     def __init__(\r\n  88:         self,\r\n  89:         registry: RoleRegistry,\r\n  90:         store: RoleExecutionStore | None = None,\r\n  91:         *,\r\n  92:         trace: RoleTrace | None = None,\r\n  93:         action_executor: RoleActionExecutor | None = None,\r\n  94:         is_cancelled: Callable[[], bool] | None = None,\r\n  95:     ) -> None:\r\n  96:         self.registry = registry\r\n  97:         self.store = store or InMemoryRoleExecutionStore()\r\n  98:         self.trace = trace\r\n  99:         self.action_executor = action_executor\r\n 100:         self.is_cancelled = is_cancelled or (lambda: False)\r\n 101: \r\n 102:     def execute(\r\n 103:         self,\r\n 104:         role_definition: RoleDefinition,\r\n 105:         role_input: BaseModel | dict[str, object],\r\n 106:         policy: RolePolicy,\r\n 107:         *,\r\n 108:         agent_run_id: str,\r\n 109:         research_session_id: str,\r\n 110:         role_execution_id: str | None = None,\r\n 111:         role_context: RoleContext,\r\n 112:         action_planner: Callable[\r\n 113:             [RoleDefinition, BaseModel, RoleContext], Iterable[object]\r\n 114:         ]\r\n 115:         | None = None,\r\n 116:     ) -> RoleResult:\r\n 117:         if not isinstance(role_context, RoleContext):\r\n 118:             raise TypeError(\"role_context must be a projected RoleContext\")\r\n 119:         if role_context.role_id != role_definition.role_id.value:\r\n 120:             raise ValueError(\"RoleContext does not match the Role definition\")\r\n 121:         registered = self.registry.get(role_definition.role_id)\r\n 122:         if registered != role_definition:\r\n 123:             raise ValueError(\"Role definition does not match the registered definition\")\r\n 124:         validated_input = registered.input_contract.model_validate(role_input)\r\n 125:         execution_id = role_execution_id or uuid4().hex\r\n 126:         execution = self._restore(execution_id) if role_execution_id else None\r\n 127:         if execution is None:\r\n 128:             execution = RoleExecution(\r\n 129:                 role_execution_id=execution_id,\r\n 130:                 role_id=registered.role_id,\r\n 131:                 agent_run_id=agent_run_id,\r\n 132:                 research_session_id=research_session_id,\r\n 133:                 trace_scope=f\"role:{execution_id}\",\r\n 134:                 runtime_profile=registered.runtime_profile,\r\n 135:             )\r\n 136:             execution.start()\r\n 137:             self._boundary(execution, \"role.start\")\r\n 138:         else:\r\n 139:             self._validate_recovery(execution, registered, agent_run_id, research_session_id)\r\n 140:             if execution.status != \"running\":\r\n 141:                 return self._result(execution)\r\n 142:             if execution.working_state.operation_in_flight is not None:\r\n 143:                 abandoned = execution.working_state.operation_in_flight\r\n 144:                 execution.working_state.operation_in_flight = None\r\n 145:                 if abandoned.get(\"kind\") == \"provider\":\r\n 146:                     self._boundary(\r\n 147:                         execution, \"role.recovery\", classification=\"provider_call_abandoned\"\r\n 148:                     )\r\n 149:                 else:\r\n 150:                     execution.working_state.intermediate_artifacts.append(\r\n 151:                         {\r\n 152:                             \"action\": abandoned.get(\"action\"),\r\n 153:                             \"failure\": \"in_flight_action_abandoned_during_recovery\",\r\n 154:                         }\r\n 155:                     )\r\n 156:                     execution.working_state.usage.failures += 1\r\n 157:                     execution.end(\r\n 158:                         status=\"terminated\",\r\n 159:                         reason=\"in_flight_action_abandoned\",\r\n 160:                         failure_message=\"Recovered an action with unknown commit outcome\",\r\n 161:                     )\r\n 162:                     self._boundary(\r\n 163:                         execution, \"role.recovery\", classification=\"in_flight_action_abandoned\"\r\n 164:                     )\r\n 165:             else:\r\n 166:                 self._boundary(execution, \"role.recovery\", classification=\"boundary_resumed\")\r\n 167: \r\n 168:         try:\r\n 169:             while execution.status == \"running\":\r\n 170:                 limit_reason = self._limit_reason(execution)\r\n 171:                 if limit_reason:\r\n 172:                     execution.end(status=\"terminated\", reason=limit_reason)\r\n 173:                     break\r\n 174:                 output = self._recover_output(execution, registered)\r\n 175:                 if output is None:\r\n 176:                     execution.working_state.operation_in_flight = {\"kind\": \"provider\"}\r\n 177:                     self._boundary(execution, \"role.step\", classification=\"decision_started\")\r\n 178:                     output = self._decide(\r\n 179:                         execution, registered, validated_input, policy, role_context\r\n 180:                     )\r\n 181:                     execution.working_state.current_step += 1\r\n 182:                     execution.working_state.last_output = output.model_dump(mode=\"json\")\r\n 183:                     execution.working_state.next_action_index = 0\r\n 184:                     execution.working_state.operation_in_flight = None\r\n 185:                     self._boundary(execution, \"role.result\", classification=\"decision_validated\")\r\n 186:                 actions = tuple(self._actions(output))\r\n 187:                 if action_planner is not None:\r\n 188:                     planner_context = role_context.model_copy(\r\n 189:                         update={\r\n 190:                             \"sections\": {\r\n 191:              