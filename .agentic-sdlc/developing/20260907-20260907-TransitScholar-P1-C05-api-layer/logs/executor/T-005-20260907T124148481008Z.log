esolve_wiki_hit_paper_ids(self, hit: Any) -> list[str]: ...\r\nsrc/transit_scholar\\layer3\\roles\\builtin.py:57:    def for_role(self, role_id: RoleId) -> RoleRuntimeProfile:\r\nsrc/transit_scholar\\layer3\\roles\\builtin.py:73:    def __init__(self, runtime_profile: RoleRuntimeProfile | None = None) -> None:\r\nsrc/transit_scholar\\layer3\\roles\\builtin.py:97:    def __init__(self, runtime_profile: RoleRuntimeProfile | None = None) -> None:\r\nsrc/transit_scholar\\layer3\\roles\\builtin.py:119:    def __init__(self, runtime_profile: RoleRuntimeProfile | None = None) -> None:\r\nsrc/transit_scholar\\layer3\\roles\\builtin.py:136:    def __init__(self, runtime_profile: RoleRuntimeProfile | None = None) -> None:\r\nsrc/transit_scholar\\layer3\\roles\\builtin.py:153:    def __init__(self, runtime_profile: RoleRuntimeProfile | None = None) -> None:\r\nsrc/transit_scholar\\layer3\\schema\\service.py:140:class PaperSchemaReadiness(BaseModel):\r\nsrc/transit_scholar\\layer3\\schema\\service.py:612:    def resolve_validated_definition(\r\nsrc/transit_scholar\\layer2\\parser\\registry.py:25:def resolve_parsers(config: Layer2Config) -> list[ParserAdapter]:\r\nsrc/transit_scholar\\layer3\\memory\\lifecycle.py:309:    def workspace_file_cleanup(self, workspace_id: str, layout: Any) -> None:\r\nsrc/transit_scholar\\layer3\\rerank\\model.py:15:class CrossPaperRanker(Protocol):\r\nsrc/transit_scholar\\layer3\\rerank\\model.py:29:class DedicatedModelReranker(CrossPaperRanker, Protocol):\r\nsrc/transit_scholar\\layer3\\retrieval\\workspace_rag.py:26:class CrossPaperCandidate(BaseModel):\r\ntest_execution_manager.py\r\ntest_foundation.py\r\ntest_conversation_persistence.py\r\ntest_local_product_bootstrap.py\r\ntest_message_preparation.py\r\ntest_research_command_guards.py\r\ntest_role_action_planner.py\r\ntest_runtime_factory_integration.py\r\ntest_runtime_state_store.py\r\ntest_two_turn_integration.py\r\nGet-ChildItem : Cannot find path 'E:\\AI_Agent_Development\\transit-scholar\\