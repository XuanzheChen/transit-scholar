                                                                 \"action\":  null,\r\n                                                                              \"source\":  \"evaluation\",\r\n                                                                              \"explanation\":  \"explicit/inferred 口径: explicit = 原文存在直接陈述/直接等价术语/表格图注实验设置直接事实, inferred = 需要跨句归纳/领域分类映射/多事实综合推出; predicted and gold disagree but both are assertive — explainable, non-blocking diagnostic\"\r\n                                                                          }\r\n                                                                      ]\r\n                                                       },\r\n                      \"metrics.metrics\":  {\r\n                                              \"field_id\":  \"metrics.metrics\",\r\n                                              \"correct\":  6,\r\n                                              \"partial\":  0,\r\n                                              \"incorrect\":  0,\r\n                                              \"not_evaluated\":  0,\r\n                                              \"missing\":  0,\r\n                                              \"status_mismatch\":  1,\r\n                                              \"issue_count\":  1,\r\n                                              \"issues\":  [\r\n                                                             {\r\n                                                                 \"type\":  \"status_mismatch\",\r\n                                                                 \"severity\":  \"warning\",\r\n                                                                 \"message\":  \"field \\u0027metrics.metrics\\u0027: expected status \\u0027explicit\\u0027 but predicted status \\u0027inferred\\u0027; explicit/inferred 口径: explicit = 原文存在直接陈述/直接等价术语/表格图注实验设置直接事实, inferred = 需要跨句归纳/领域分类映射/多事实综合推出; predicted and gold disagree but both are assertive — explainable, non-blocking diagnostic\",\r\n                                                                 \"fields\":  [\r\n                                                                                \"metrics.metrics\"\r\n                                                                            ],\r\n                                                                 \"action\":  null,\r\n                                                                 \"source\":  \"evaluation\",\r\n                                                                 \"explanation\":  \"explicit/inferred 口径: explicit = 原文存在直接陈述/直接等价术语/表格图注实验设置直接事实, inferred = 需要跨句归纳/领域分类映射/多事实综合推出; predicted and gold disagree but both are assertive — explainable, non-blocking diagnostic\"\r\n                                                             }\r\n                                                         ]\r\n                                          },\r\n                      \"results.main_results\":  {\r\n                                                   \"field_id\":  \"results.main_results\",\r\n                                                   \"correct\":  6,\r\n                                                   \"partial\":  0,\r\n                                                   \"incorrect\":  0,\r\n                                                   \"not_evaluated\":  0,\r\n                                                   \"missing\":  0,\r\n                                                   \"status_mismatch\":  1,\r\n                                                   \"issue_count\":  1,\r\n                                                   \"issues\":  [\r\n                                                                  {\r\n                                                                      \"type\":  \"status_mismatch\",\r\n                                                                      \"severity\":  \"warning\",\r\n                                                                      \"message\":  \"field \\u0027results.main_results\\u0027: expected status \\u0027explicit\\u0027 but predicted status \\u0027inferred\\u0027; explicit/inferred 口径: explicit = 原文存在直接陈述/直接等价术语/表格图注实验设置直接事实, inferred = 需要跨句归纳/领域分类映射/多事实综合推出; predicted and gold disagree but both are assertive — explainable, non-blocking diagnostic\",\r\n                                                                      \"fields\":  [\r\n                                                                                     \"results.main_results\"\r\n                                                                                 ],\r\n                                                                      \"action\":  null,\r\n                                                                      \"source\":  \"evaluation\",\r\n                                                                      \"explanation\":  \"explicit/inferred 口径: explicit = 原文存在直接陈述/直接等价术语/表格图注实验设置直接事实, inferred = 需要跨句归纳/领域分类映射/多事实综合推出; predicted and gold disagree but both are assertive — explainable, non-blocking diagnostic\"\r\n                                                                  }\r\n                                                              ]\r\n                                               }\r\n                  }\r\n}\r\n","exit_code":0,"status":"completed"}}
