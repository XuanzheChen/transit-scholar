\n    \"pymupdf>=1.24\",\r\n    \"rapidfuzz>=3.0\",\r\n    \"fastapi>=0.115\",\r\n    \"uvicorn>=0.30\",\r\n    \"python-multipart>=0.0.9\",\r\n    \"python-dotenv>=1.0\",\r\n    \"pydantic>=2.0\",\r\n    \"pyyaml>=6.0\",\r\n]\r\n\r\n[project.optional-dependencies]\r\ndev = [\r\n    \"pytest>=8.0\",\r\n]\r\n# Optional heavy production dependencies for Layer2 parsing/retrieval. None are\r\n# required by the automated offline test suite: the Layer2 code uses adapter /\r\n# provider boundaries that report an explicit ``dependency_missing`` status when\r\n# these are absent (docling/mineru/pymupdf4llm/lancedb) or when a cloud API key\r\n# is not configured (httpx for the provider adapters).\r\nlayer2 = [\r\n    \"docling>=2\",\r\n    \"mineru[all]\",\r\n    \"pymupdf4llm>=0.1\",\r\n    \"lancedb>=0.10\",\r\n    \"httpx>=0.27\",\r\n]\r\n\r\n[tool.setuptools.packages.find]\r\nwhere = [\"src\"]\r\n\r\n[tool.pytest.ini_options]\r\ntestpaths = [\"tests\"]\r\naddopts = \"-p no:cacheprovider\"\r\n D doc/20260829-Layer3-Stage1-Integrate-Verify.md\n D doc/20260830-Layer3-Stage2-Research-Execution-Foundation.md\n D doc/20260831-L3S4-Research-Reasoning-Ledger.md\n D doc/L3S5_ACCEPTANCE_MATRIX.md\n","exit_code":0,"status":"completed"}}
