se(\r\ntests\\test_l2s2_llm_real_provider.py:340:        return httpx.Response(\r\ntests\\test_l2s2_llm_real_provider.py:354:        return httpx.Response(200, json={\"choices\": []})\r\ntests\\test_l2s2_llm_real_provider.py:366:        return httpx.Response(401, text=\"unauthorized\")\r\ntests\\test_l2s2_llm_real_provider.py:381:        return httpx.Response(500, text=\"server error\")\r\ntests\\test_l2s2_llm_real_provider.py:392:        raise httpx.ReadTimeout(\"timed out\", request=request)\r\ntests\\test_l2s2_llm_real_provider.py:412:            return httpx.Response(429, text=\"rate limited\")\r\ntests\\test_l2s2_llm_real_provider.py:426:        return httpx.Response(429, text=\"rate limited\")\r\ntests\\test_l2s2_llm_real_provider.py:448:            return httpx.Response(429, text=\"rate limited\")\r\ntests\\test_l2s2_llm_real_provider.py:499:        return httpx.Response(500, text=\"boom\")\r\ntests\\test_l2s2_llm_real_provider.py:526:        return httpx.Response(\r\ntests\\test_l2s2_llm_real_provider.py:546:        return httpx.Response(\r\ntests\\test_l2s2_llm_real_provider.py:573:    client = _client(lambda request: httpx.Response(500, text=\"x\"))\r\ntests\\test_stage7_web_api.py:5:never touched. No ``httpx`` / ``starlette.testclient.TestClient`` is used — the\r\ntests\\test_stage7_web_api.py:60:    create_app(data_root=root)\r\ntests\\test_stage7_web_api.py:100:    \"\"\"create_app(data_root=...) must point the whole stack at that root.\r\ntests\\test_stage7_web_api.py:109:    create_app(data_root=project_tmp_path)\r\ntests\\test_stage7_web_api.py:368:    app = create_app(data_root=api_root)\r\n            CitationRecord.deleted_at.is_(None),\r\n        )\r\n    ).scalars().all():\r\n        rec.is_selected = False\r\n\r\n\r\n# ---------------------------------------------------------------------------\r\n# Listing\r\n# ---------------------------------------------------------------------------\r\n\r\n\r\ndef list_citation_records(\r\n    paper_id: str,\r\n    *,\r\n    include_deleted: bool = False,\r\n) -> list[CitationRecordView]:\r\n    \"\"\"Return citation records for a paper, optionally including deleted ones.\"\"\"\r\n    with SessionLocal() as session:\r\n        stmt = select(CitationRecord).where(CitationRecord.paper_id == paper_id)\r\n        if not include_deleted:\r\n            stmt = stmt.where(CitationRecord.deleted_at.is_(None))\r\n        rows = session.execute(stmt.order_by(CitationRecord.created_at)).scalars().all()\r\n        return [_to_view(r) for r in rows]\r\n\r\n\r\ndef get_selected_citation_record(\r\n    paper_id: str,\r\n) -> CitationRecordView | None:\r\n    \"\"\"Return the currently selected (non-deleted) citation record, if any.\"\"\"\r\n    with SessionLocal() as session:\r\n        row = session.execute(\r\n            select(CitationRecord).where(\r\n                CitationRecord.paper_id == paper_id,\r\n                CitationRecord.is_selected.is_(True),\r\n                CitationRecord.deleted_at.is_(None),\r\n            )\r\n        ).scalar_one_or_none()\r\n        return _to_view(row) if row is not None else None\r\n\r\n\r\n# ---------------------------------------------------------------------------\r\n# Select\r\n        doi=doi,\r\n        job=job,\r\n        registry=registry,\r\n        rate_limiter=rate_limiter,\r\n        force=force,\r\n    )\r\n\r\n\r\ndef refresh_enrichment(\r\n    paper_id: str,\r\n    *,\r\n    registry: ProviderRegistry | None = None,\r\n    rate_limiter: SerialRateLimiter | None = None,\r\n) -> EnrichmentJobResult:\r\n    \"\"\"Manually re-run enrichment, ignoring cached provider results.\"\"\"\r\n    return enrich_paper_by_doi(\r\n        paper_id,\r\n        registry=registry,\r\n        rate_limiter=rate_limiter,\r\n        force=True,\r\n    )\r\n\r\n\r\ndef _get_or_create_job(\r\n    session, paper: Paper, *, force: bool\r\n) -> DOIEnrichmentJob:\r\n    existing = session.execute(\r\n        select(DOIEnrichmentJob).where(DOIEnrichm