r as exc:\nsrc/transit_scholar/api/routers\\runs.py:48:        raise ApiError(\"RUN_STATE_CONFLICT\", str(exc), {\"agent_run_id\": agent_run_id}, 409) from exc\nsrc/transit_scholar/api/routers\\runs.py:56:            raise ApiError(\"RUN_STATE_CONFLICT\", \"resume_run is only allowed for paused runs\", {\"agent_run_id\": agent_run_id}, 409)\nsrc/transit_scholar/api/routers\\runs.py:60:        raise ApiError(\"RUNNER_BUSY\", \"Another AgentRun is already executing\", {}, 409) from exc\nsrc/transit_scholar/api/routers\\runs.py:62:        raise ApiError(\"NOT_FOUND\", \"agent run not found\", {\"agent_run_id\": agent_run_id}, 404) from exc\nsrc/transit_scholar/api/routers\\runs.py:63:    except ProductConflictError as exc:\nsrc/transit_scholar/api/routers\\runs.py:64:        raise ApiError(\"RUN_STATE_CONFLICT\", str(exc), {\"agent_run_id\": agent_run_id}, 409) from exc\nsrc/transit_scholar/api/routers\\papers.py:7:from fastapi import APIRouter, Depends, File, Query, UploadFile, status\nsrc/transit_scholar/api/routers\\papers.py:36:        raise ApiError(code, result.error_message or \"Paper operation failed\", {\"paper_id\": result.paper_id}, 404 if code == \"NOT_FOUND\" else 400)\nsrc/transit_scholar/api/routers\\papers.py:46:def import_paper(file: UploadFile = File(...), product=Depends(get_product)):\nsrc/transit_scholar/api/routers\\papers.py:48:        raise ApiError(\"INVALID_FILE_TYPE\", \"Only PDF uploads are supported\", {\"content_type\": file.content_type}, 422)\nsrc/transit_scholar/api/routers\\papers.py:58:                    raise ApiError(\"UPLOAD_TOO_LARGE\", \"PDF exceeds configured upload limit\", {\"max_bytes\": settings.max_file_size_bytes}, 413)\nsrc/transit_scholar/api/routers\\papers.py:70:        raise ApiError(\"NOT_FOUND\", \"Paper not found\", {\"paper_id\": paper_id}, 404)\nsrc/transit_scholar/api/routers\\papers.py:79:        raise ApiError(\"NOT_FOUND\", \"Paper not found\", {\"paper_id\": paper_id}, 404)\nsrc/transit_scholar/api/routers\