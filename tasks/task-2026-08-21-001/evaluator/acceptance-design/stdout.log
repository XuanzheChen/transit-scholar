{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"\"C:\\\\windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command 'Get-Content scripts/l2s2_runtime_smoke.py'","aggregated_output":"#!/usr/bin/env python\r\n\"\"\"L2S2 minimal real-runtime smoke (AC-RW-18).\r\n\r\nProves, against the user's configured ``.env`` real LLM endpoint, that the\r\nnormal runtime composition works end to end for ONE paper and a SMALL field\r\nsubset:\r\n\r\n    .env -> ensure_project_dotenv (single bootstrap boundary)\r\n        -> resolve_runtime_llm_client (unified runtime resolver)\r\n        -> Extraction (shared real client + real HybridRetrievalWrapper)\r\n        -> Semantic Verification (real StructuredSemanticVerifier on the SAME\r\n           client)\r\n        -> optional Targeted Recheck (same client, per-field)\r\n\r\nIt prints ONLY provider, model, client class, allow_network / block_network\r\nand per-field results. It NEVER prints the API key, the ``Authorization``\r\nheader, or the full base URL, and it NEVER re-runs the six-paper acceptance.\r\n\r\nWhen the runtime is not authorized (unconfigured, missing fields, or\r\n``TRANSIT_SCHOLAR_BLOCK_NETWORK`` set), it reports an explicit skip/failure\r\nwith a non-zero exit code and NEVER falls back to a fake success.\r\n\r\nNOTE: this script is intentionally NOT part of the pytest suite; it is the\r\nPlanner/user-controlled real smoke. The L2S1 parse + retrieval indices for\r\n``--paper`` must already exist (e.g. the gold papers transit-001..016).\r\n\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nimport argparse\r\nimport os\r\nimport sys\r\nfrom pathlib import Path\r\nfrom typing import Any\r\n\r\nREPO_ROOT = Path(__file__).resolve().parents[1]\r\nDEFAULT_STORAGE_ROOT = REPO_ROOT / \"temp\" / \"l2s2_runtime_smoke\" / \"data\" / \"layer2\" / \"schemas\"\r\n\r\n\r\ndef _parse_args(argv: list[str] | None = None) -> argparse.Namespace:\r\n    parser = argparse.ArgumentParser(\r\n        prog=\"l2s2_runtime_smoke\",\r\n        description=(\r\n            \"Minimal real L2S2 runtime smoke: one paper, few fields, real \"\r\n            \"LLM client shared by Extractor / Semantic Verifier / Recheck.\"\r\n        ),\r\n    )\r\n    parser.add_argument(\r\n        \"--paper\", required=True, help=\"paper id with existing L2S1 parse + retrieval\"\r\n    )\r\n    parser.add_argument(\"--schema\", default=\"bus_control_rl\")\r\n    parser.add_argument(\r\n        \"--fields\",\r\n        nargs=\"*\",\r\n        default=None,\r\n        help=\"optional subset of field ids to recheck after extraction\",\r\n    )\r\n    parser.add_argument(\"--top-k\", type=int, default=8)\r\n    parser.add_argument(\r\n        \"--storage-root\",\r\n        default=str(DEFAULT_STORAGE_ROOT),\r\n        help=\"isolated schema-run storage root (default under temp/)\",\r\n    )\r\n    parser.add_argument(\r\n        \"--rerank\",\r\n        action=\"store_true\",\r\n        help=\"opt in to reranking (default off for the minimal smoke)\",\r\n    )\r\n    return parser.parse_args(argv)\r\n\r\n\r\ndef _short(value: Any) -> str:\r\n    \"\"\"A safe one-line representation of a value (never raw secrets).\"\"\"\r\n    if value is None:\r\n        return \"None\"\r\n    text = repr(value)\r\n    if len(text) > 160:\r\n        text = text[:157] + \"...\"\r\n    return text\r\n\r\n\r\ndef _env_flag(name: str) -> str:\r\n    raw = os.environ.get(name)\r\n    return raw if raw is not None else \"<unset>\"\r\n\r\n\r\ndef main(argv: list[str] | None = None) -> int:\r\n    args = _parse_args(argv)\r\n\r\n    # 1) single project-root dotenv bootstrap (never modified, never per-module)\r\n    from transit_scholar.config import ensure_project_dotenv\r\n\r\n    ensure_project_dotenv()\r\n\r\n    from transit_scholar.layer2.schema_extraction import (\r\n        LLMUnavailableError,\r\n        extract_schema,\r\n        recheck_fields,\r\n        resolve_runtime_llm_client,\r\n    )\r\n    from transit_scholar.layer2.schema_extraction.retrieval import (\r\n        HybridRetrievalWrapper,\r\n    )\r\n\r\n    # 2) unified runtime resolver (blocked / unconfigured -> explicit failure)\r\n    try:\r\n        client = resolve_runtime_llm_client()\r\n    except LLMUnavailableError as exc:\r\n        print(f\"L2S2 runtime smoke: LLM unavailable -> explicit skip (no fake success)\")\r\n        print(f\"  reason: {exc}\", file=sys.stderr)\r\n        print(\r\n            \"  to enable the real smoke, set TRANSIT_SCHOLAR_LLM_PROVIDER=openai_compatible, \"\r\n            \"TRANSIT_SCHOLAR_LLM_MODEL, TRANSIT_SCHOLAR_LLM_API_KEY, \"\r\n            \"TRANSIT_SCHOLAR_LLM_BASE_URL, TRANSIT_SCHOLAR_LLM_ALLOW_NETWORK=1, and unset \"\r\n            \"(or set to 0) TRANSIT_SCHOLAR_BLOCK_NETWORK.\",\r\n            file=sys.stderr,\r\n        )\r\n        return 3\r\n\r\n    print(\"L2S2 runtime smoke (real runtime wiring)\")\r\n    print(f\"  provider={getattr(client, 'provider_name', 'unknown')}\")\r\n    print(f\"  model={getattr(client, 'model_name', 'unknown')}\")\r\n    print(f\"  client_class={type(client).__name__}\")\r\n    print(f\"  allow_network={_env_flag('TRANSIT_SCHOLAR_LLM_ALLOW_NETWORK')}\")\r\n    print(f\"  block_network={_env_flag('TRANSIT_SCHOLAR_BLOCK_NETWORK')}\")\r\n    # NOTE: intentionally NO api key / Authorization header / full base URL.\r\n\r\n    retrieval = HybridRetrievalWrapper(top_k=args.top_k, rerank=args.rerank)\r\n    storage_root = Path(args.storage_root)\r\n    print(f\"  storage_root={storage_root}\")\r\n\r\n    print(f\"  extract_schema(paper={args.paper!r}, schema={args.schema!r}) ...\")\r\n    extract_kwargs = dict(\r\n        paper_id=args.paper,\r\n        schema_id=args.schema,\r\n        llm_client=client,\r\n        retrieval=retrieval,\r\n        top_k=args.top_k,\r\n        storage_root=storage_root,\r\n    )\r\n    result = extract_schema(**extract_kwargs)\r\n    print(f\"  run_id={result.run_id}  schema_id={result.instance.schema_id}  \"\r\n          f\"report_status={result.report.status}\")\r\n    for field_id, field in sorted(result.instance.fields.items()):\r\n        print(f\"    {field_id}: status={field.status} value={_short(field.value)}\")\r\n\r\n    if args.fields:\r\n        print(f\"  recheck_fields({args.fields!r}) ...\")\r\n        recheck_kwargs = dict(\r\n            paper_id=args.paper,\r\n            schema_id=args.schema,\r\n            field_ids=args.fields,\r\n            llm_client=client,\r\n            retrieval=retrieval,\r\n            top_k=args.top_k,\r\n            storage_root=storage_root,\r\n        )\r\n        recheck_result = recheck_fields(**recheck_kwargs)\r\n        print(f\"  recheck run_id={recheck_result.run_id}  \"\r\n              f\"report_status={recheck_result.report.status}\")\r\n        for entry in recheck_result.report.recheck_trace.entries:\r\n            updated = \"updated\" if entry.updated else f\"error={entry.error_code}\"\r\n            print(f\"    {entry.field_id}: {entry.original_status} -> \"\r\n                  f\"{entry.new_status} ({updated})\")\r\n        field = recheck_result.instance.fields[args.fields[0]]\r\n        print(f\"    {args.fields[0]}: status={field.status} value={_short(field.value)}\")\r\n\r\n    print(\"L2S2 runtime smoke: completed (real runtime path)\")\r\n    return 0\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n","exit_code":0,"status":"completed"}}
